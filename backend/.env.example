SPRING_PROFILES_ACTIVE=default
PORT=8080

# Uses the same Omnichannel database as ManagementBE. ManagementBE owns Flyway.
DB_URL=jdbc:postgresql://localhost:5432/omnichannel_pos
DB_USERNAME='FILL_DATABASE_USERNAME'
DB_PASSWORD='FILL_DATABASE_PASSWORD'

# Admin and tenant frontends.
ADMIN_ALLOWED_ORIGIN_PATTERNS=http://localhost:5174,http://127.0.0.1:5174
TENANT_LOGIN_URL=http://localhost:5173/login

# Resend SMTP.
MAIL_HOST=smtp.resend.com
MAIL_PORT=587
MAIL_USERNAME=resend
MAIL_PASSWORD='FILL_RESEND_API_KEY'
MAIL_SMTP_AUTH=true
MAIL_STARTTLS=true
MAIL_STARTTLS_REQUIRED=true
MAIL_CONNECTION_TIMEOUT_MS=5000
MAIL_READ_TIMEOUT_MS=5000
MAIL_WRITE_TIMEOUT_MS=5000
ADMIN_MAIL_FROM='FILL_VERIFIED_SENDER_EMAIL'

# Enable only for the first local Platform Owner creation, then disable it and
# clear email/password from the real .env or IDE Run Configuration.
APP_ADMIN_BOOTSTRAP_ENABLED=false
APP_ADMIN_BOOTSTRAP_EMAIL=
APP_ADMIN_BOOTSTRAP_PASSWORD=
APP_ADMIN_BOOTSTRAP_DISPLAY_NAME='Platform Owner'
APP_ADMIN_BOOTSTRAP_ROTATE_PASSWORD=false
